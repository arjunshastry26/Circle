# Keys clients use to call YOUR gateway (comma-separated, any string you want)
GATEWAY_API_KEYS=test-key-123

RATE_LIMIT_PER_MINUTE=20

# Real provider keys - the gateway holds these, clients never see them
# Replace these with your own keys from each provider console
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Only needed if running outside docker compose (compose sets these itself)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://openrouter:openrouter@localhost:5432/openrouter
